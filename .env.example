# MEP Pricing Intelligence — Environment Variables
# Copy to .env and fill in values before running setup.bat or docker compose.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# DB_HOST: use "postgres" inside Docker Compose, "localhost" for local psql/tests
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mep_ops
DB_USER=mep_user
DB_PASSWORD=changeme

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# JWT_SECRET: long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Seeded Users ──────────────────────────────────────────────────────────────
# Two users are seeded on first setup: one admin (read/write) and one estimator (read-only).
# Generate a bcrypt hash with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YourPassword!'))"

# Admin account — full access (upload, review, catalog management)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$examplehashgoeshere

# Estimator account — read-only (search, estimate, view products/vendors)
ESTIMATOR_EMAIL=estimator@example.com
ESTIMATOR_PASSWORD_HASH=$2b$12$examplehashgoeshere

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use "*" for local dev only.
# For production, set to your actual domain(s): https://mep.example.com
CORS_ORIGINS=*

# ── Frontend / Admin API URL ──────────────────────────────────────────────────
# Used by Vite at build time. In production with nginx, use /api (no host needed).
VITE_API_URL=http://localhost:8000
